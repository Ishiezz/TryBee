{
    "name": "try-before-you-buy",
    "version": "1.0.0",
    "description": "A try-before-you-buy e-commerce platform",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "client": "cd client && npm start",
        "dev:full": "concurrently \"npm run dev\" \"npm run client\""
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.8.6",
        "stripe": "^14.25.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.15.3",
        "concurrently": "^8.2.2",
        "nodemon": "^3.1.10"
    }
}
